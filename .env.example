# Copy to .env (git ignores it) and fill in. squint reads credentials from the environment only,
# so load this file into your shell before running:  set -a; source .env; set +a
# Each account line is the attestation `[privacy] account` in your config expands, for example
#   account = "anthropic:${SQUINT_ANTHROPIC_ACCOUNT}"
ANTHROPIC_API_KEY=
SQUINT_ANTHROPIC_ACCOUNT=   # your Anthropic organisation id (org-…)
GEMINI_API_KEY=
SQUINT_GOOGLE_ACCOUNT=      # your Google Cloud project id
OPENAI_API_KEY=
SQUINT_OPENAI_ACCOUNT=      # your OpenAI organisation id (org-…)
FAL_KEY=                      # fal.ai, for FLUX.2 klein set generation (scripts/sets)
