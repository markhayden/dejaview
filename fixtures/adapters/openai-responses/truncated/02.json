                  },
                  "location": {
                    "$ref": "#/$defs/Location"
                  },
                  "obligation_ids": {
                    "description": "One to eight rule ids as numbered under Obligations, for example `SF4`; never checklist item ids.",
                    "items": {
                      "type": "string"
                    },
                    "type": "array"
                  },
                  "reason": {
                    "description": "One to a few sentences; at most 600 characters.",
                    "type": "string"
                  }
                },
                "required": [
                  "allowed_by",
                  "confidence",
                  "disposition",
                  "evidence",
                  "location",
                  "obligation_ids",
                  "reason"
                ],
                "type": "object"
              },
              "FindingDisposition": {
                "description": "Dispositions a finding may carry. `held` and `hidden` belong to checklist items only.",
                "enum": [
                  "violation",
                  "allowed_change",
                  "cant_tell",
                  "observed"
                ],
                "type": "string"
              },
              "ItemDisposition": {
                "additionalProperties": false,
                "description": "What the model said about one checklist item. Items carry no obligation ids: the checklist\nowns them.",
                "properties": {
                  "allowed_by": {
                    "description": "Exemption id; required when `disposition = allowed_change`, null otherwise.",
