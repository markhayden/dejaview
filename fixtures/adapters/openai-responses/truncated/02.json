                  }
                },
                "required": [
                  "reason",
                  "verdict"
                ],
                "type": "object"
              }
            },
            "additionalProperties": false,
            "description": "The canonical submission, schema version 1. Every property is required; optional values are\nnullable, so the shape survives every provider's strict mode.",
