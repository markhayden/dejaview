{
  "adapter": "gemini-generate-content",
  "wire_version": 1,
  "strict": false,
  "schema": {
    "additionalProperties": false,
    "description": "The canonical submission, schema version 1. Every property is required; optional values are\nnullable, so the shape survives every provider's strict mode.",
    "properties": {
      "findings": {
        "items": {
          "additionalProperties": false,
          "description": "Something the model noticed beyond the checklist.",
          "properties": {
            "allowed_by": {
              "type": [
                "string",
                "null"
              ]
            },
            "confidence": {
              "enum": [
                "confident",
                "tentative"
              ],
              "type": "string"
            },
            "disposition": {
              "description": "Dispositions a finding may carry. `held` and `hidden` belong to checklist items only.",
              "enum": [
                "violation",
                "allowed_change",
                "cant_tell",
                "observed"
              ],
              "type": "string"
            },
            "evidence": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "location": {
              "additionalProperties": false,
              "description": "A location as a tagged record with nullable fields (see SPEC \"Frames and locations\").",
              "properties": {
                "bbox": {
                  "items": {
                    "type": "number"
                  },
                  "maxItems": 4,
                  "minItems": 4,
                  "type": [
                    "array",
                    "null"
                  ]
                },
                "fov": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "frame": {
                  "type": "string"
                },
                "kind": {
                  "enum": [
                    "bbox",
                    "polygon",
                    "view",
                    "whole_image",
                    "absent"
                  ],
                  "type": "string"
                },
                "pitch": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "polygon": {
                  "items": {
                    "items": {
                      "type": "number"
                    },
                    "maxItems": 2,
                    "minItems": 2,
                    "type": "array"
                  },
                  "type": [
                    "array",
                    "null"
                  ]
                },
                "yaw": {
                  "type": [
                    "number",
                    "null"
                  ]
                }
              },
              "required": [
                "bbox",
                "fov",
                "frame",
                "kind",
                "pitch",
                "polygon",
                "yaw"
              ],
              "type": "object"
            },
            "obligation_ids": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "reason": {
              "type": "string"
            }
          },
          "required": [
            "allowed_by",
            "confidence",
            "disposition",
            "evidence",
            "location",
            "obligation_ids",
            "reason"
          ],
          "type": "object"
        },
        "type": "array"
      },
      "items": {
        "items": {
          "additionalProperties": false,
          "description": "What the model said about one checklist item. Items carry no obligation ids: the checklist\nowns them.",
          "properties": {
            "allowed_by": {
              "description": "Exemption id; required when `disposition = allowed_change`, null otherwise.",
              "type": [
                "string",
                "null"
              ]
            },
            "confidence": {
              "enum": [
                "confident",
                "tentative"
              ],
              "type": "string"
            },
            "disposition": {
              "enum": [
                "violation",
                "held",
                "allowed_change",
                "hidden",
                "cant_tell",
                "observed"
              ],
              "type": "string"
            },
            "evidence": {
              "description": "Tool call ids from this run used as evidence.",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "id": {
              "type": "string"
            },
            "location": {
              "anyOf": [
                {
                  "additionalProperties": false,
                  "description": "A location as a tagged record with nullable fields (see SPEC \"Frames and locations\").",
                  "properties": {
                    "bbox": {
                      "items": {
                        "type": "number"
                      },
                      "maxItems": 4,
                      "minItems": 4,
                      "type": [
                        "array",
                        "null"
                      ]
                    },
                    "fov": {
                      "type": [
                        "number",
                        "null"
                      ]
                    },
                    "frame": {
                      "type": "string"
                    },
                    "kind": {
                      "enum": [
                        "bbox",
                        "polygon",
                        "view",
                        "whole_image",
                        "absent"
                      ],
                      "type": "string"
                    },
                    "pitch": {
                      "type": [
                        "number",
                        "null"
                      ]
                    },
                    "polygon": {
                      "items": {
                        "items": {
                          "type": "number"
                        },
                        "maxItems": 2,
                        "minItems": 2,
                        "type": "array"
                      },
                      "type": [
                        "array",
                        "null"
                      ]
                    },
                    "yaw": {
                      "type": [
                        "number",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "bbox",
                    "fov",
                    "frame",
                    "kind",
                    "pitch",
                    "polygon",
                    "yaw"
                  ],
                  "type": "object"
                },
                {
                  "type": "null"
                }
              ]
            },
            "reason": {
              "type": "string"
            }
          },
          "required": [
            "allowed_by",
            "confidence",
            "disposition",
            "evidence",
            "id",
            "location",
            "reason"
          ],
          "type": "object"
        },
        "type": "array"
      },
      "opinion": {
        "additionalProperties": false,
        "description": "Recorded, never read by aggregation.",
        "properties": {
          "reason": {
            "type": "string"
          },
          "verdict": {
            "type": "string"
          }
        },
        "required": [
          "reason",
          "verdict"
        ],
        "type": "object"
      },
      "schema_version": {
        "minimum": 0,
        "type": "integer"
      }
    },
    "required": [
      "findings",
      "items",
      "opinion",
      "schema_version"
    ],
    "type": "object"
  },
  "changes": [
    "/properties/schema_version/format: removed (uint32)",
    "/$defs/Disposition/oneOf: rewritten as anyOf",
    "/$defs/Disposition/anyOf/1/const: rewritten as enum",
    "/$defs/Disposition/anyOf: enums merged into one enum",
    "/$defs/Location/properties/bbox/items/format: removed (double)",
    "/$defs/Location/properties/fov/format: removed (double)",
    "/$defs/Location/properties/pitch/format: removed (double)",
    "/$defs/Location/properties/polygon/items/items/format: removed (double)",
    "/$defs/Location/properties/yaw/format: removed (double)",
    "/$defs: inlined into every reference"
  ]
}
